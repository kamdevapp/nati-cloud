# Środowisko budowania AppImage Nati: starszy system (Ubuntu 22.04, glibc 2.35) – paczka działa na nowszych.
FROM docker.io/library/ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential pkg-config meson ninja-build nasm git curl xz-utils ca-certificates python3 file \
      clang cmake libgtk-3-dev liblzma-dev libsecret-1-dev libstdc++-12-dev unzip \
      libass-dev libgnutls28-dev libpulse-dev libasound2-dev zlib1g-dev libopus-dev libmp3lame-dev patchelf \
    && rm -rf /var/lib/apt/lists/*
